# Old Wix site links → new site (301 = permanent, keeps search rankings)
# Note: Cloudflare Pages already serves /contact, /faq, /account, /product etc. (no .html) – never redirect those to *.html (loops).
/product-page/:slug      /product?slug=:slug                 301

# Wix store / category pages
/shop                    /?cat=all#prints                    301
/shop/*                  /?cat=all#prints                    301
/category/all-products   /?cat=all#prints                    301
/category/:cat           /?cat=:cat#prints                   301
/welding-caps            /?cat=welding-caps#prints           301
/custom-items            /?cat=custom-items#prints           301
/skull-caps              /?q=skull&cat=all#prints            301
/emb-designs             /?q=embroidery&cat=all#prints       301
/emb-beanies             /?q=beanie&cat=all#prints           301
/fabrics                 /?q=fabric&cat=all#prints           301
/pdf-patterns            /?q=pattern&cat=all#prints          301

